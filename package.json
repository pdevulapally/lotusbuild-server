{
  "name": "lotusbuild-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "runner": "node --experimental-strip-types src/runner/index.ts",
    "runner:dev": "node --watch --experimental-strip-types src/runner/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "e2b": "^2.45.0",
    "fastify": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
