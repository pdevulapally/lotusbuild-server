# Installed to /etc/caddy/Caddyfile.
#
# Caddy terminates TLS and is the only thing exposed. The API stays bound to
# 127.0.0.1:4100 (HOST in .env), so it is unreachable except through here.
# The certificate is issued automatically over ACME on port 80; that works
# because api.lotusbuild.co.uk already resolves to this box.
api.lotusbuild.co.uk {
	encode zstd gzip

	# `encode` only touches responses, so the Stripe webhook still verifies:
	# its signature is over the raw request body, which is proxied untouched.
	# SSE is flushed immediately by Caddy for text/event-stream. Stream closure,
	# including a proxy reload/timeout, only disconnects the observer. Commands
	# commit in Firestore and the separate runner never depends on this socket.
	# Do not enable upstream POST retries: clients retry using Idempotency-Key.
	reverse_proxy 127.0.0.1:4100 {
		# Replace rather than append. Caddy's default appends the real peer to
		# whatever X-Forwarded-For the client sent, and Fastify runs with
		# trustProxy, so it reads the leftmost entry — which the client controls.
		# The IP-keyed rate limits on /plans and the Stripe webhook are only
		# real if this header is ours.
		header_up X-Forwarded-For {remote_host}
	}
}
