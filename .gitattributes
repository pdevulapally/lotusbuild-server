# Never shipped to a server. `deploy.sh` builds the payload with `git archive`,
# which honours export-ignore, so these are a CI gate and nothing more —
# production holds no test files, workflows or service-unit installation files.
# The atomic exchange helper is required by deploy.sh and must be shipped.
/test export-ignore
/.github export-ignore
/deploy/*.service export-ignore
/tsconfig.test.json export-ignore
/.gitattributes export-ignore
